# Data + regenerable binary outputs — never commit
data/
figures/
*.png
*.parquet

# CSVs are ignored by default, EXCEPT the generated result tables. Those are the
# artifacts behind every reported number: 216 KB total, plain text, and diffable — so a
# re-run that moves a coverage figure shows up in review instead of silently replacing
# the only copy. Figures stay ignored: regenerable from these CSVs, and binary diffs
# would bloat history on every run.
*.csv
!tables/*.csv

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Environments / secrets
.venv/
.env
*.env

# OS
.DS_Store
Thumbs.db

# Checkpoint fingerprints (machine-state sidecars, regenerated every run)
tables/*.fingerprint.json

# Paper working documents and templates — never commit (double-blind: filenames alone can deanonymize)
*.docx
neurips_2026.tex
neurips_2026.sty
checklist.tex
paper/methodology_draft.md

# Local tooling and OS clutter
.claude/
.DS_Store
