# Keep the build context small and the image free of host-specific or generated state.
# Anything listed here is invisible to the Docker build, even if a COPY line names it.

.git
.github
.claude
.pytest_cache
**/__pycache__
**/*.pyc
.venv
venv
.DS_Store

# Mounted at run time, never baked in (licence + size + already revision-pinned).
data
figures
tables
tables_prefix_revelation_backup

# Prose: not needed to execute anything, and keeps rebuilds from busting the cache
# every time a note is edited.
notes
paper
docs
LICENSE

# Host-specific dependency files. The image installs from requirements.lock.txt only;
# copying these in would invite installing from the wrong one.
requirements.txt
requirements-repro.in
